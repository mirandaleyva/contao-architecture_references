{% extends "@Contao/frontend_module/_base.html.twig" %}

{% block content %}
    {% if reference %}
        <article class="architecture-reference-detail">

            <h1>{{ reference.title }}</h1>

            {% if reference.previewImage %}
                <figure class="architecture-reference-main-image">
                    <img src="{{ reference.previewImage }}" alt="{{ reference.title }}">
                </figure>
            {% endif %}

            {% if reference.long_description %}
                <div class="architecture-reference-long-description">
                    {{ reference.long_description|raw }}
                </div>
            {% endif %}

            {% if reference.galleryImages is not empty %}
                <div class="architecture-reference-gallery">
                    {% for image in reference.galleryImages %}
                        <figure class="architecture-reference-gallery-item">
                            <img src="{{ image }}" alt="{{ reference.title }}">
                        </figure>
                    {% endfor %}
                </div>
            {% endif %}

            <div class="architecture-reference-meta">

                {% if reference.location %}
                    <p><strong>Ort:</strong> {{ reference.location }}</p>
                {% endif %}

                {% if reference.completion %}
                    <p><strong>Fertigstellung:</strong> {{ reference.completion }}</p>
                {% endif %}

                {% if reference.work %}
                    <p><strong>Arbeit:</strong> {{ reference.work }}</p>
                {% endif %}

                {% if reference.status %}
                    <p><strong>Status:</strong> {{ reference.status }}</p>
                {% endif %}

                {% if reference.photographer %}
                    <p><strong>Fotograf:</strong> {{ reference.photographer }}</p>
                {% endif %}

                {% if reference.visualizer %}
                    <p><strong>Visualisierung:</strong> {{ reference.visualizer }}</p>
                {% endif %}

            </div>

        </article>
    {% endif %}
{% endblock %}